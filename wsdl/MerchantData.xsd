      <xs:element minOccurs="0" name="StartTime" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation> The &lt;b&gt;StartTime&lt;/b&gt; value returned by non-search calls
            such as &lt;b&gt;GetItem&lt;/b&gt; is the time stamp (in GMT) for when the item was
