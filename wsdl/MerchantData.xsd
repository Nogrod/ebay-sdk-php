                </CallInfo>
              </xs:appinfo>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="RelistItemResponse" type="ns:RelistItemResponseType" />
  <xs:complexType name="RelistItemResponseType">
    <xs:annotation>
      <xs:documentation> The base response type for the &lt;b&gt;RelistItem&lt;/b&gt; call. The
