      <xs:element minOccurs="0" name="MaxNativeEstimatedDeliveryTime" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation> The &lt;b&gt;MinNativeEstimatedDeliveryTime&lt;/b&gt; and
