              <Returned>Conditionally</Returned>
            </CallInfo>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="Street" type="xs:string">
        <xs:annotation>
          <xs:documentation> A concatenation of &lt;b&gt;Street1&lt;/b&gt; and
            &lt;b&gt;Street2&lt;/b&gt;, primarily used for a registration address. </xs:documentation>
