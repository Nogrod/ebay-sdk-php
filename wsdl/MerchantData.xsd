            </CallInfo>
            <CallInfo>
              <CallName>GetBidderList</CallName>
              <Returned>Always</Returned>
            </CallInfo>
            <CallInfo>
              <CallName>GetItem</CallName>
              <Details>DetailLevel: none, ItemReturnDescription, ItemReturnAttributes, ReturnAll</Details>
              <Returned>Always</Returned>
            </CallInfo>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" name="ConvertedReservePrice" type="ns:AmountType">
        <xs:annotation>
          <xs:documentation> Converted value of the &lt;b&gt;ReservePrice&lt;/b&gt; in the currency
            of the site that returned this response. Only returned for listings with a reserve price
            when the requesting user is the listing's seller. For active items, refresh this value
