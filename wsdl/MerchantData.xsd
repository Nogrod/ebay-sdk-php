      <xs:element minOccurs="0" name="HasReservePrice" type="xs:boolean">
        <xs:annotation>
          <xs:documentation> If &lt;code&gt;true&lt;/code&gt;, the seller specified a value in
            &lt;b&gt;ReservePrice&lt;/b&gt;. </xs:documentation>
          <xs:appinfo>
            <CallInfo>
              <CallName>GetBidderList</CallName>
              <Returned>Always</Returned>
            </CallInfo>
            <CallInfo>
              <CallName>GetItem</CallName>
              <Details>DetailLevel: none, ItemReturnDescription, ItemReturnAttributes, ReturnAll</Details>
